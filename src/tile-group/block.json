{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "awt/tile-group",
	"carbonStyles": [
		"tile",
		"form"
	],
	"awt_component": "tile",
	"title": "Tile group",
	"category": "awt-data-display",
	"description": "A set of selectable tiles where visitors pick one, with a heading. Give the tiles the same group name.",
	"textdomain": "awt-blocks",
	"keywords": [
		"tile group",
		"radio tile",
		"choice",
		"carbon"
	],
	"supports": {
		"html": false,
		"reusable": true,
		"className": true,
		"anchor": true
	},
	"attributes": {
		"label": {
			"type": "string",
			"default": "Choose an option"
		}
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php",
	"style": "file:./style-index.css"
}
