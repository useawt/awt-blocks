# --- AWT free repo: awt-blocks ---

# Dependencies
/node_modules/

# Build output — generated from src/ by `npm run build`.
# Shipped via .distignore at package time, never committed. Keeping build/ out
# of git means a removed block (e.g. a block moved to AWT Premium) can never
# linger as a stale compiled artifact in the public repo.
/build/

# AWT Premium implementation code must never live in this free repo.
# It belongs in the awt-premium repo. (See awt-stage-1-spec.md §6 "Build sequencing".)
/premium-staging/
**/premium-staging/

# OS / editor cruft
.DS_Store
*.log
npm-debug.log*
/vendor/
/test-results/
/playwright-report/
.phpunit.result.cache
.perf-status
# Playwright/wp-env test-utils login state. Regenerated by every e2e run, and
# it holds a WordPress session cookie for the local test site — not something to
# commit to a public repo. Nothing reads it as a fixture: the storageState
# Playwright actually uses is /test-results/.auth/, ignored above.
/artifacts/

# Logos the UI-shell launch gate uploads through the Media Library. The seed
# uploads folder is committed fixture content, so without this a gate run leaves
# an artifact staged for commit. reset.sh sweeps them before each run; this
# catches the one the last run leaves behind.
.wp-env/seed/uploads/**/gate-logo*.png
